# Proxy para salas 3+
# ROOM3_TOKEN=token_sala_3
# ROOM3_PROXY=http://127.0.0.1:9050

# ─── Senhas dos Cargos ──────────────────
CAP=senha_capitao
SUBCAP=senha_subcapitao
JOGADOR=senha_jogador
