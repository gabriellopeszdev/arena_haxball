GEO_LAT=-23.5167
GEO_LON=-46.6463

# ─── Salas (máx 2 por IP sem proxy) ─────
ROOM1_NAME=🫄🏻 ARENA TERQUILA 🫄🏻
# ROOM1_PUBLIC=true   (true=pública, false=privada; padrão pública se omitido)
ROOM2_NAME=🦉 ARENA GIU 🦉
